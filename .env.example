# ==============================================================================
# SHOPEE OPEN API V2 SIMULATOR - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=8080

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Database Connection (PostgreSQL via Prisma ORM)
# Use 'localhost' when running npm run dev / npm test directly on your host machine
DATABASE_URL="postgresql://shopee:shopee_mock_password@localhost:5432/shopee_mock_db?schema=public"

# Use 'postgres' when running inside Docker container network:
# DATABASE_URL="postgresql://shopee:shopee_mock_password@postgres:5432/shopee_mock_db?schema=public"
